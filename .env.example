# Frontend environment variables.
# Copy to .env.local for local development. Never commit .env.local.

# Base URL of the Spring Boot API. Used only inside Next.js route handlers,
# so it is NOT prefixed with NEXT_PUBLIC_ and never reaches the browser bundle.
#
# Local development:
SPRING_API_URL=http://localhost:8080
#
# Production (Railway): set this to the backend service's public URL, e.g.
# SPRING_API_URL=https://leave-management-api.up.railway.app